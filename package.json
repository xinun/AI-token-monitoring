{
  "name": "ai-token",
  "private": true,
  "version": "0.3.4",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1",
    "package:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "release:draft": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/draft-release.ps1",
    "icons": "node scripts/generate-icon.mjs",
    "updater:key": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-updater-key.ps1",
    "clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean.ps1",
    "clean:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean.ps1 -DebugOnly",
    "tauri": "tauri",
    "test": "node --test scripts/*.test.mjs",
    "probe:codex": "node scripts/probe-codex.mjs",
    "check:env": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-env.ps1"
  },
  "dependencies": { "@tauri-apps/api": "^2.0.0" },
  "devDependencies": { "@tauri-apps/cli": "^2.0.0", "typescript": "~5.9.0", "vite": "^7.0.0" }
}
