{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Token",
  "version": "0.2.0",
  "identifier": "com.aitoken.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "resources": {
      "../BRAND_ASSETS.md": "BRAND_ASSETS.md",
      "../LICENSE": "LICENSE"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCNUIxNjYxNzY4NkI4REYKUldUZnVJWjJZUlpidXlBdk5JOEVZL0g0YXpvYlBobTIzeHJqdENFS1R1SnBDWUtOVDYxL2doSEIK",
      "requireSignedVersion": true,
      "allowDowngrades": false,
      "endpoints": [
        "https://github.com/xinun/AI-token-monitoring/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}